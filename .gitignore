# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log
# ...except the sample logs the test suite reads. The directory must be
# re-included first: git does not descend into an excluded directory, so a
# negation for files inside it would never be evaluated.
!tests/fixtures/logs/
!tests/fixtures/logs/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env / secrets
.env
.env.*
!.env.example

# Docker
.dockerignore
docker-compose.override.yml
*.tar
*.tar.gz

# Open Horizon
horizon/*.tar.gz
horizon/*.json.tmp

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Monitor runtime state
proposals/
